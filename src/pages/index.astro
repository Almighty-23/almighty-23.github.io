---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/siteConfig';
---

<BaseLayout>
  <!-- ============================================================================
       FLOATING BENTO VERSION SWITCHER (底部悬浮：4 种 Bento 细分风格切换器)
       ============================================================================ -->
  <div
    class="fixed bottom-5 left-1/2 -translate-x-1/2 z-50 w-[95%] max-w-2xl bg-[#141413]/95 text-[#F7F6F2] backdrop-blur-md border border-white/15 shadow-2xl p-2 sm:px-4 sm:py-2.5 rounded-2xl flex flex-col sm:flex-row items-center justify-between gap-2"
    role="region"
    aria-label="Bento 风格版本切换器"
  >
    <div class="flex items-center gap-2 text-xs font-mono shrink-0">
      <span class="w-2 h-2 rounded-full bg-[#10B981]"></span>
      <span class="text-white font-semibold">Bento 风格预览</span>
      <span class="hidden md:inline text-[#A09E97]">（按键 1-4 切换）</span>
    </div>

    <div class="grid grid-cols-4 gap-1.5 w-full sm:w-auto" role="tablist">
      <button
        type="button"
        data-bento-target="v1"
        class="bento-switch-btn px-2.5 py-1.5 rounded-xl text-xs font-mono font-medium transition-all bg-white text-[#141413]"
      >
        1. 暖陶松林
      </button>
      <button
        type="button"
        data-bento-target="v2"
        class="bento-switch-btn px-2.5 py-1.5 rounded-xl text-xs font-mono font-medium transition-all bg-[#252523] text-[#E5E3DC] hover:bg-[#333330]"
      >
        2. 曜石暗夜
      </button>
      <button
        type="button"
        data-bento-target="v3"
        class="bento-switch-btn px-2.5 py-1.5 rounded-xl text-xs font-mono font-medium transition-all bg-[#252523] text-[#E5E3DC] hover:bg-[#333330]"
      >
        3. 纯白侧栏
      </button>
      <button
        type="button"
        data-bento-target="v4"
        class="bento-switch-btn px-2.5 py-1.5 rounded-xl text-xs font-mono font-medium transition-all bg-[#252523] text-[#E5E3DC] hover:bg-[#333330]"
      >
        4. 柔雾玻璃
      </button>
    </div>
  </div>

  <!-- ============================================================================
       VERSION 1: 暖陶松林 · WARM CLAY & PINE (原版 Bento 升级版)
       ============================================================================ -->
  <div id="bento-panel-v1" class="bento-panel bento-v1-bg min-h-screen pb-28">
    <!-- Top Floating Pill Navigation Directory -->
    <header class="sticky top-4 z-30 max-w-6xl mx-auto px-4 sm:px-8 pt-2">
      <div class="bg-white/90 backdrop-blur-md border border-black/5 rounded-full px-5 py-3 shadow-sm flex items-center justify-between">
        <a href="#" class="flex items-center gap-2.5 font-bold text-sm tracking-tight">
          <span class="w-7 h-7 rounded-full bg-[#0F5243] text-white flex items-center justify-center text-xs font-serif">
            {siteConfig.name}
          </span>
          <span>{siteConfig.handle}</span>
        </a>

        <nav aria-label="主目录" class="hidden sm:flex items-center gap-1">
          {
            siteConfig.nav.map((item) => (
              <a
                href={`#v1-${item.id}`}
                class="px-3.5 py-1.5 rounded-full text-xs font-medium text-[#5A5852] hover:bg-[#F2EFE9] hover:text-[#161615] transition-colors"
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <a
          href={siteConfig.github}
          target="_blank"
          rel="noopener noreferrer"
          class="px-3.5 py-1.5 rounded-full bg-[#161615] text-white text-xs font-medium hover:bg-[#0F5243] transition-colors"
        >
          GitHub ↗
        </a>
      </div>
    </header>

    <div class="max-w-6xl mx-auto px-4 sm:px-8 pt-8 space-y-6">
      <!-- Row 1: Hero Profile Card (7 cols) + Status & Quick Info (5 cols) -->
      <section id="v1-about" class="grid grid-cols-1 md:grid-cols-12 gap-5">
        <!-- Main Profile Tile -->
        <div class="bento-v1-card md:col-span-7 p-7 sm:p-9 flex flex-col justify-between space-y-8">
          <div class="flex items-start justify-between gap-4">
            <div class="flex items-center gap-4">
              <div class="w-16 h-16 rounded-2xl bg-[#0F5243] text-white flex items-center justify-center font-serif text-3xl font-bold shadow-sm">
                {siteConfig.name}
              </div>
              <div>
                <span class="text-xs font-mono text-[#78756E]">ABOUT / 个人简介</span>
                <h1 class="text-2xl sm:text-3xl font-bold tracking-tight mt-0.5">
                  {siteConfig.name} · {siteConfig.handle}
                </h1>
              </div>
            </div>
            <span class="px-3 py-1 rounded-full bg-[#E6F4EA] text-[#0F5243] text-xs font-medium">
              个人主页
            </span>
          </div>

          <!-- Empty State Bio Area -->
          <div class="bento-v1-slot p-6 space-y-2">
            <div class="text-xs font-mono text-[#78756E]">BIO / 一句话简介与个人介绍</div>
            <p class="text-sm sm:text-base text-[#5A5852]">
              {siteConfig.bio || '暂未填写个人简介 — 可在 src/data/siteConfig.ts 中填入你的自我介绍、研究方向或个人标签。'}
            </p>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-3 pt-1">
            <div class="flex flex-wrap gap-2">
              <span class="px-3 py-1.5 rounded-full bg-[#F4F2ED] text-[#686660] text-xs font-mono">
                # 标签待添加
              </span>
              <span class="px-3 py-1.5 rounded-full bg-[#F4F2ED] text-[#686660] text-xs font-mono">
                # 领域待添加
              </span>
            </div>
            <a
              href={siteConfig.github}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-mono text-[#0F5243] font-semibold hover:underline"
            >
              github.com/{siteConfig.handle} ↗
            </a>
          </div>
        </div>

        <!-- Right Column: Now & Metrics Slots (5 cols) -->
        <div id="v1-now" class="md:col-span-5 grid grid-cols-1 gap-5">
          <!-- Forest Pine Card: Now / Current Status -->
          <div class="bento-v1-card p-7 bg-gradient-to-br from-[#0F5243] to-[#09352B] text-white flex flex-col justify-between space-y-5">
            <div class="flex items-center justify-between text-xs font-mono opacity-80">
              <span>NOW / 当下状态</span>
              <span>STATUS</span>
            </div>
            <div class="py-2">
              <p class="text-xs uppercase tracking-wider opacity-70">近期动态</p>
              <p class="text-base sm:text-lg font-medium mt-1.5 leading-relaxed opacity-90">
                {siteConfig.status || '暂无近期状态记录（待添加）'}
              </p>
            </div>
            <div class="flex items-center justify-between text-xs pt-3 border-t border-white/15 opacity-80 font-mono">
              <span>坐标：{siteConfig.location || '待填写'}</span>
              <span>2026</span>
            </div>
          </div>

          <!-- Directory Summary Card -->
          <div class="bento-v1-card p-6 grid grid-cols-3 gap-3 text-center">
            <div class="p-3 rounded-2xl bg-[#F7F5F0]">
              <div class="text-xl font-bold text-[#0F5243]">{siteConfig.projects.length}</div>
              <div class="text-xs text-[#686660] mt-1">作品项目</div>
            </div>
            <div class="p-3 rounded-2xl bg-[#F7F5F0]">
              <div class="text-xl font-bold text-[#FF5A26]">{siteConfig.notes.length}</div>
              <div class="text-xs text-[#686660] mt-1">文章笔记</div>
            </div>
            <div class="p-3 rounded-2xl bg-[#F7F5F0]">
              <div class="text-xl font-bold text-[#161615]">—</div>
              <div class="text-xs text-[#686660] mt-1">待扩展项</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Row 2: Projects Directory Bento Card -->
      <section id="v1-projects" class="bento-v1-card p-7 sm:p-9 space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-black/5 pb-5">
          <div>
            <span class="text-xs font-mono text-[#0F5243] font-semibold">DIRECTORY 01 · PROJECTS</span>
            <h2 class="text-2xl font-bold mt-0.5">作品集展示</h2>
          </div>

          <!-- Category Filter Pills Directory -->
          <div class="flex flex-wrap gap-2">
            {
              siteConfig.projectCategories.map((cat, idx) => (
                <span
                  class={`px-3.5 py-1.5 rounded-full text-xs font-medium ${
                    idx === 0
                      ? 'bg-[#161615] text-white'
                      : 'bg-[#F4F2ED] text-[#686660]'
                  }`}
                >
                  {cat}
                </span>
              ))
            }
          </div>
        </div>

        <!-- Empty State Slots for Projects -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div class="bento-v1-slot p-8 flex flex-col items-center justify-center text-center min-h-[180px] space-y-2">
            <div class="w-10 h-10 rounded-full bg-white border border-black/10 flex items-center justify-center text-sm font-mono text-[#0F5243]">
              01
            </div>
            <p class="font-semibold text-sm">作品卡片位置 01（空）</p>
            <p class="text-xs text-[#78756E] max-w-xs">
              后续在 <code class="font-mono">siteConfig.ts</code> 的 <code class="font-mono">projects</code> 中添加项目名称、简介与链接即可自动展示。
            </p>
          </div>

          <div class="bento-v1-slot p-8 flex flex-col items-center justify-center text-center min-h-[180px] space-y-2">
            <div class="w-10 h-10 rounded-full bg-white border border-black/10 flex items-center justify-center text-sm font-mono text-[#78756E]">
              +
            </div>
            <p class="font-semibold text-sm text-[#5A5852]">更多作品插槽（待添加）</p>
            <p class="text-xs text-[#78756E]">支持项目预览链接、GitHub 仓库与技术栈标签</p>
          </div>
        </div>
      </section>

      <!-- Row 3: Notes / Blog Directory (8 cols) + Contact Directory (4 cols) -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
        <section id="v1-notes" class="bento-v1-card md:col-span-8 p-7 sm:p-9 space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-black/5 pb-5">
            <div>
              <span class="text-xs font-mono text-[#FF5A26] font-semibold">DIRECTORY 02 · NOTES</span>
              <h2 class="text-2xl font-bold mt-0.5">博客与文章笔记</h2>
            </div>
            <div class="flex flex-wrap gap-1.5">
              {
                siteConfig.noteCategories.map((cat, idx) => (
                  <span
                    class={`px-3 py-1 rounded-full text-xs font-medium ${
                      idx === 0 ? 'bg-[#FFF0EB] text-[#FF5A26]' : 'bg-[#F4F2ED] text-[#686660]'
                    }`}
                  >
                    {cat}
                  </span>
                ))
              }
            </div>
          </div>

          <div class="bento-v1-slot p-8 text-center space-y-2">
            <p class="text-sm font-semibold text-[#5A5852]">暂无已发布的文章笔记</p>
            <p class="text-xs text-[#78756E]">
              添加文章后将在此处按时间倒序排列，并自动生成独立的文章阅读页。
            </p>
          </div>
        </section>

        <section id="v1-contact" class="bento-v1-card md:col-span-4 p-7 sm:p-9 flex flex-col justify-between space-y-6">
          <div>
            <span class="text-xs font-mono text-[#78756E]">DIRECTORY 03 · LINKS</span>
            <h2 class="text-2xl font-bold mt-0.5">社交与联络</h2>
          </div>

          <div class="space-y-3">
            {
              siteConfig.socials.map((s) => (
                <div class="flex items-center justify-between p-3.5 rounded-2xl bg-[#F7F5F0] text-xs">
                  <span class="font-semibold">{s.label}</span>
                  {s.url ? (
                    <a href={s.url} target="_blank" rel="noopener noreferrer" class="font-mono text-[#0F5243] hover:underline">
                      {s.value} ↗
                    </a>
                  ) : (
                    <span class="font-mono text-[#8C8980]">{s.value}</span>
                  )}
                </div>
              ))
            }
          </div>
        </section>
      </div>
    </div>
  </div>

  <!-- ============================================================================
       VERSION 2: 曜石暗夜 · OBSIDIAN DARK BENTO (Linear / Raycast 质感暗黑便当盒)
       ============================================================================ -->
  <div id="bento-panel-v2" class="bento-panel hidden bento-v2-bg min-h-screen pb-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-8 pt-6 space-y-6">
      <!-- Top Dark Bento Bar -->
      <header class="bento-v2-card px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="w-2.5 h-2.5 rounded-full bg-[#10B981]"></span>
          <span class="font-mono text-sm font-semibold tracking-tight">{siteConfig.name} // {siteConfig.handle}</span>
        </div>

        <nav aria-label="暗色版主目录" class="hidden sm:flex items-center gap-6 text-xs font-mono text-[#94A3B8]">
          {
            siteConfig.nav.map((item) => (
              <a href={`#v2-${item.id}`} class="hover:text-white transition-colors">
                {item.label}
              </a>
            ))
          }
        </nav>

        <a
          href={siteConfig.github}
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/15 text-xs font-mono text-white transition-colors"
        >
          GitHub ↗
        </a>
      </header>

      <!-- 4-Tile Asymmetric Dashboard Hero -->
      <section id="v2-about" class="grid grid-cols-1 md:grid-cols-12 gap-4">
        <div class="bento-v2-card md:col-span-8 p-8 flex flex-col justify-between space-y-6">
          <div class="flex items-center justify-between text-xs font-mono text-[#64748B]">
            <span>01 // PROFILE OVERVIEW</span>
            <span class="text-[#10B981]">ONLINE</span>
          </div>

          <div class="space-y-3">
            <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-white">
              {siteConfig.name} <span class="text-[#64748B] font-normal">({siteConfig.handle})</span>
            </h1>
            <div class="bento-v2-slot p-5 text-sm text-[#94A3B8]">
              {siteConfig.bio || '个人简介待填写 — 此区域用于展示你的个人介绍、方向与核心标签。'}
            </div>
          </div>

          <div class="flex flex-wrap gap-2 text-xs font-mono text-[#64748B]">
            <span class="px-3 py-1 rounded-md bg-white/5 border border-white/5">[标签待添加]</span>
            <span class="px-3 py-1 rounded-md bg-white/5 border border-white/5">[技术栈待添加]</span>
          </div>
        </div>

        <div id="v2-now" class="md:col-span-4 grid grid-cols-1 gap-4">
          <div class="bento-v2-card p-6 flex flex-col justify-between space-y-4">
            <div class="flex items-center justify-between text-xs font-mono text-[#64748B]">
              <span>02 // NOW</span>
              <span class="text-[#10B981]">STATUS</span>
            </div>
            <div class="bento-v2-slot p-4 text-xs text-[#94A3B8]">
              近期动态：{siteConfig.status || '待添加'}
            </div>
          </div>

          <div id="v2-contact" class="bento-v2-card p-6 flex flex-col justify-between space-y-3">
            <div class="text-xs font-mono text-[#64748B]">03 // CHANNELS</div>
            {
              siteConfig.socials.map((s) => (
                <div class="flex items-center justify-between text-xs font-mono py-1 border-b border-white/5 last:border-0">
                  <span class="text-[#94A3B8]">{s.label}</span>
                  {s.url ? (
                    <a href={s.url} target="_blank" rel="noopener noreferrer" class="text-[#10B981] hover:underline">
                      {s.value} ↗
                    </a>
                  ) : (
                    <span class="text-[#475569]">{s.value}</span>
                  )}
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Projects & Notes Split Bento Row -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
        <section id="v2-projects" class="bento-v2-card md:col-span-6 p-7 space-y-5">
          <div class="flex items-center justify-between">
            <div>
              <span class="text-xs font-mono text-[#10B981]">04 // PROJECTS</span>
              <h2 class="text-xl font-bold text-white mt-0.5">作品集目录</h2>
            </div>
            <div class="flex gap-1.5 text-xs font-mono text-[#64748B]">
              {siteConfig.projectCategories.slice(0, 3).map((c) => (
                <span class="px-2.5 py-1 rounded bg-white/5">{c}</span>
              ))}
            </div>
          </div>

          <div class="space-y-3">
            <div class="bento-v2-slot p-8 text-center space-y-1.5">
              <p class="text-sm font-medium text-[#CBD5E1]">暂无作品项目（待添加）</p>
              <p class="text-xs text-[#64748B]">支持展示项目卡片、仓库链接与技术标签</p>
            </div>
          </div>
        </section>

        <section id="v2-notes" class="bento-v2-card md:col-span-6 p-7 space-y-5">
          <div class="flex items-center justify-between">
            <div>
              <span class="text-xs font-mono text-[#38BDF8]">05 // NOTES</span>
              <h2 class="text-xl font-bold text-white mt-0.5">文章与笔记目录</h2>
            </div>
            <div class="flex gap-1.5 text-xs font-mono text-[#64748B]">
              {siteConfig.noteCategories.slice(0, 3).map((c) => (
                <span class="px-2.5 py-1 rounded bg-white/5">{c}</span>
              ))}
            </div>
          </div>

          <div class="bento-v2-slot p-8 text-center space-y-1.5">
            <p class="text-sm font-medium text-[#CBD5E1]">暂无文章笔记（待添加）</p>
            <p class="text-xs text-[#64748B]">添加文章后将在此列表归档展示</p>
          </div>
        </section>
      </div>
    </div>
  </div>

  <!-- ============================================================================
       VERSION 3: 纯白侧栏画廊 · NORDIC PURE GALLERY (左侧固定目录 + 右侧纯白便当盒)
       ============================================================================ -->
  <div id="bento-panel-v3" class="bento-panel hidden bento-v3-bg min-h-screen pb-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-8 py-10 grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <!-- Left 3 Cols: Sticky Index Sidebar Bento Card -->
      <aside class="lg:col-span-3 lg:sticky lg:top-8 bento-v3-card p-6 space-y-6">
        <div class="flex items-center gap-3 pb-4 border-b border-gray-100">
          <div class="w-10 h-10 rounded-xl bg-[#111315] text-white flex items-center justify-center font-bold">
            {siteConfig.name}
          </div>
          <div>
            <div class="font-bold text-base">{siteConfig.name}</div>
            <div class="text-xs font-mono text-gray-400">@{siteConfig.handle}</div>
          </div>
        </div>

        <div class="space-y-1">
          <div class="text-[11px] font-mono text-gray-400 px-2 pb-1">INDEX / 页面目录</div>
          {
            siteConfig.nav.map((item, idx) => (
              <a
                href={`#v3-${item.id}`}
                class={`block px-3 py-2 rounded-xl text-xs font-medium transition-colors ${
                  idx === 0 ? 'bg-gray-100 text-black font-semibold' : 'text-gray-600 hover:bg-gray-50'
                }`}
              >
                0{idx + 1}. {item.label}
              </a>
            ))
          }
        </div>

        <div class="pt-4 border-t border-gray-100 space-y-2 text-xs">
          <div class="text-[11px] font-mono text-gray-400">EXTERNAL</div>
          <a
            href={siteConfig.github}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between py-1 font-mono text-gray-700 hover:text-black"
          >
            <span>GitHub</span>
            <span>↗</span>
          </a>
        </div>
      </aside>

      <!-- Right 9 Cols: Pure White Bento Feed -->
      <div class="lg:col-span-9 space-y-5">
        <section id="v3-about" class="bento-v3-card p-8 space-y-4">
          <div class="text-xs font-mono text-gray-400">01 / ABOUT</div>
          <h1 class="text-2xl sm:text-3xl font-bold">{siteConfig.name}</h1>
          <div class="bento-v3-slot p-6 text-sm text-gray-500">
            {siteConfig.bio || '个人简介区域（当前为空）'}
          </div>
        </section>

        <section id="v3-projects" class="bento-v3-card p-8 space-y-5">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <div class="text-xs font-mono text-gray-400">02 / PROJECTS</div>
              <h2 class="text-xl font-bold mt-0.5">作品集展示</h2>
            </div>
            <div class="flex gap-1.5">
              {siteConfig.projectCategories.map((c, i) => (
                <span class={`px-3 py-1 rounded-lg text-xs ${i === 0 ? 'bg-black text-white' : 'bg-gray-100 text-gray-600'}`}>
                  {c}
                </span>
              ))}
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="bento-v3-slot p-8 text-center text-xs text-gray-400">
              作品卡片槽位 01（空）
            </div>
            <div class="bento-v3-slot p-8 text-center text-xs text-gray-400">
              作品卡片槽位 02（空）
            </div>
          </div>
        </section>

        <section id="v3-notes" class="bento-v3-card p-8 space-y-5">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
