---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/siteConfig';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// 自动读取 src/content/posts/ 下所有非草稿的 Markdown 文章，按日期倒序排列
const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout>
  <div class="aura-bg min-h-screen py-8 sm:py-12 px-4 sm:px-8">
    <div class="max-w-5xl mx-auto space-y-6">
      <!-- ====================================================================
           TOP FLOATING FROSTED SEGMENTED NAVIGATION (居中磨砂胶囊目录栏)
           ==================================================================== -->
      <header class="sticky top-4 z-40 flex justify-center">
        <nav
          aria-label="页面主目录"
          class="glass-card px-3 py-2 flex flex-wrap items-center gap-1 shadow-sm"
        >
          {
            siteConfig.nav.map((item, idx) => (
              <a
                href={`#${item.id}`}
                class={`px-4 py-1.5 rounded-full text-xs font-medium transition-all ${
                  idx === 0
                    ? 'bg-slate-900 text-white shadow-sm'
                    : 'text-slate-600 hover:bg-white/70 hover:text-slate-900'
                }`}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </header>

      <!-- ====================================================================
           ROW 1: ABOUT PROFILE (8 COLS) + NOW STATUS (4 COLS)
           ==================================================================== -->
      <section id="about" class="grid grid-cols-1 md:grid-cols-12 gap-5 pt-2">
        <!-- Profile Bento Card -->
        <div class="glass-card md:col-span-8 p-7 sm:p-9 flex flex-col justify-between space-y-6">
          <div class="flex items-center justify-between gap-4">
            <div class="flex items-center gap-4">
              <div class="w-14 h-14 rounded-2xl bg-slate-900 text-white flex items-center justify-center text-2xl font-bold shadow-sm">
                {siteConfig.name}
              </div>
              <div>
                <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
                  {siteConfig.name}
                </h1>
                <p class="text-xs font-mono text-slate-500 mt-0.5">@{siteConfig.handle}</p>
              </div>
            </div>

            <span class="px-3 py-1 rounded-full bg-white/70 border border-white text-xs font-medium text-slate-600">
              个人主页与随笔
            </span>
          </div>

          <div class="glass-slot p-6 text-sm text-slate-600 leading-relaxed">
            {siteConfig.bio || '个人简介区域（当前置空，可在 src/data/siteConfig.ts 中填写）'}
          </div>
        </div>

        <!-- Now Status Bento Card -->
        <div id="now" class="glass-card md:col-span-4 p-7 sm:p-9 flex flex-col justify-between space-y-4">
          <div class="flex items-center justify-between text-xs font-mono text-slate-500">
            <span>NOW / 当下</span>
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          </div>

          <div class="glass-slot p-5 text-xs text-slate-500 text-center leading-relaxed">
            {siteConfig.status || '近期状态（当前置空）'}
          </div>

          <a
            href={siteConfig.github}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-2.5 rounded-full bg-slate-900 text-white text-xs font-mono text-center hover:bg-slate-800 transition-colors"
          >
            GitHub @{siteConfig.handle} ↗
          </a>
        </div>
      </section>

      <!-- ====================================================================
           ROW 2: ESSAYS & NOTES (随笔与文章专栏 — 核心模块，支持分类筛选)
           ==================================================================== -->
      <section id="notes" class="glass-card p-7 sm:p-9 space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200/60 pb-5">
          <div>
            <span class="text-xs font-mono text-slate-500">ESSAYS &amp; NOTES</span>
            <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mt-0.5">
              随笔与文章笔记
            </h2>
          </div>

          <!-- Category Filter Buttons -->
          <div class="flex flex-wrap gap-1.5" role="group" aria-label="文章分类筛选">
            {
              siteConfig.noteCategories.map((cat, idx) => (
                <button
                  type="button"
                  data-note-filter={cat}
                  class={`note-filter-btn px-3.5 py-1.5 rounded-full text-xs font-medium transition-all ${
                    idx === 0
                      ? 'bg-slate-900 text-white'
                      : 'bg-white/60 text-slate-600 hover:bg-white'
                  }`}
                >
                  {cat}
                </button>
              ))
            }
          </div>
        </div>

        {
          allPosts.length > 0 ? (
            <div class="grid grid-cols-1 gap-4" id="posts-list">
              {allPosts.map((post) => (
                <a
                  href={`${base}/posts/${post.slug}`}
                  data-post-category={post.data.category}
                  class="post-card-item p-6 rounded-2xl bg-white/60 hover:bg-white/90 border border-white/80 transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-4 group"
                >
                  <div class="space-y-1.5">
                    <div class="flex items-center gap-2.5 text-xs font-mono text-slate-500">
                      <span class="px-2.5 py-0.5 rounded-full bg-slate-900/5 text-slate-700">
                        {post.data.category}
                      </span>
                      <time>{post.data.date}</time>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
                      {post.data.title}
                    </h3>
                    {post.data.summary && (
                      <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                        {post.data.summary}
                      </p>
                    )}
                  </div>
                  <span class="text-xs font-mono text-slate-500 group-hover:translate-x-1 transition-transform shrink-0">
                    阅读全文 →
                  </span>
                </a>
              ))}
            </div>
          ) : (
            <div class="glass-slot p-10 text-center space-y-2">
              <p class="text-sm font-medium text-slate-700">暂无已发布的随笔与文章</p>
              <p class="text-xs text-slate-500">
                在 <code class="font-mono bg-white/70 px-1.5 py-0.5 rounded">src/content/posts/</code> 文件夹下新建 <code class="font-mono">.md</code> 文件即可自动发布展示
              </p>
            </div>
          )
        }
      </section>

      <!-- ====================================================================
           ROW 3: PROJECTS (8 COLS) + CONTACT LINKS (4 COLS)
           ==================================================================== -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
        <!-- Projects Bento Card -->
        <section id="projects" class="glass-card md:col-span-8 p-7 sm:p-9 space-y-5">
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200/60 pb-4">
            <div>
              <span class="text-xs font-mono text-slate-500">PROJECTS</span>
              <h2 class="text-xl font-bold text-slate-900 mt-0.5">作品集展示</h2>
            </div>
            <div class="flex flex-wrap gap-1.5">
              {
                siteConfig.projectCategories.map((c, i) => (
                  <span
                    class={`px-3 py-1 rounded-full text-xs ${
                      i === 0 ? 'bg-slate-900 text-white' : 'bg-white/60 text-slate-600'
                    }`}
                  >
                    {c}
                  </span>
                ))
              }
            </div>
          </div>

          {
            siteConfig.projects.length > 0 ? (
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {siteConfig.projects.map((p) => (
                  <div class="p-5 rounded-2xl bg-white/60 border border-white/80 space-y-2">
                    <div class="text-xs font-mono text-slate-500">{p.category} · {p.year}</div>
                    <h3 class="text-base font-bold text-slate-900">{p.title}</h3>
                    <p class="text-xs text-slate-600 leading-relaxed">{p.summary}</p>
                  </div>
                ))}
              </div>
            ) : (
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="glass-slot p-8 text-center text-xs text-slate-500">
                  作品卡片位置 01（空）
                </div>
                <div class="glass-slot p-8 text-center text-xs text-slate-500">
                  作品卡片位置 02（空）
                </div>
              </div>
            )
          }
        </section>

        <!-- Contact Bento Card -->
        <section id="contact" class="glass-card md:col-span-4 p-7 sm:p-9 flex flex-col justify-between space-y-5">
          <div>
            <span class="text-xs font-mono text-slate-500">CONTACT</span>
            <h2 class="text-xl font-bold text-slate-900 mt-0.5">联络与链接</h2>
          </div>

          <div class="space-y-2.5">
            {
              siteConfig.socials.map((s) => (
                <div class="p-3.5 rounded-2xl bg-white/60 border border-white/80 flex items-center justify-between text-xs">
                  <span class="font-medium text-slate-700">{s.label}</span>
                  {s.url ? (
                    <a
                      href={s.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-mono text-slate-900 hover:underline"
                    >
                      {s.value} ↗
                    </a>
                  ) : (
                    <span class="font-mono text-slate-400">{s.value}</span>
                  )}
                </div>
              ))
            }
          </div>
        </section>
      </div>
    </div>
  </div>

  <!-- Category Filtering Script for Notes -->
  <script is:inline>
    const filterButtons = document.querySelectorAll('.note-filter-btn');
    const postCards = document.querySelectorAll('.post-card-item');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selected = btn.getAttribute('data-note-filter');
        filterButtons.forEach((b) => {
          b.className =
            'note-filter-btn px-3.5 py-1.5 rounded-full text-xs font-medium transition-all bg-white/60 text-slate-600 hover:bg-white';
        });
        btn.className =
          'note-filter-btn px-3.5 py-1.5 rounded-full text-xs font-medium transition-all bg-slate-900 text-white';

        postCards.forEach((card) => {
          const cat = card.getAttribute('data-post-category');
          if (selected === '全部' || cat === selected) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
</BaseLayout>
