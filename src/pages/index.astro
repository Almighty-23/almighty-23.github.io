  <!-- Client Switcher Script -->
  <script is:inline>
    const bentoBtns = document.querySelectorAll('.bento-switch-btn');
    const bentoPanels = {
      v1: document.getElementById('bento-panel-v1'),
      v2: document.getElementById('bento-panel-v2'),
      v3: document.getElementById('bento-panel-v3'),
      v4: document.getElementById('bento-panel-v4'),
    };

    function activateBento(versionKey) {
      if (!bentoPanels[versionKey]) return;
      Object.entries(bentoPanels).forEach(([k, panel]) => {
        if (!panel) return;
        if (k === versionKey) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });

      bentoBtns.forEach((btn) => {
        const target = btn.getAttribute('data-bento-target');
        if (target === versionKey) {
          btn.className =
            'bento-switch-btn px-2.5 py-1.5 rounded-xl text-xs font-mono font-medium transition-all bg-white text-[#141413]';
        } else {
          btn.className =
            'bento-switch-btn px-2.5 py-1.5 rounded-xl text-xs font-mono font-medium transition-all bg-[#252523] text-[#E5E3DC] hover:bg-[#333330]';
        }
      });

      localStorage.setItem('preferred-bento-version', versionKey);
    }

    bentoBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-bento-target');
        if (target) activateBento(target);
      });
    });

    window.addEventListener('keydown', (e) => {
      if (['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName || '')) return;
      if (e.key === '1') activateBento('v1');
      if (e.key === '2') activateBento('v2');
      if (e.key === '3') activateBento('v3');
      if (e.key === '4') activateBento('v4');
    });

    const urlBento = new URLSearchParams(window.location.search).get('bento');
    const savedBento = localStorage.getItem('preferred-bento-version');
    if (urlBento && bentoPanels[urlBento]) {
      activateBento(urlBento);
    } else if (savedBento && bentoPanels[savedBento]) {
      activateBento(savedBento);
    }
  </script>
