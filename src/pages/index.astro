---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/siteConfig';

const defaultLens = siteConfig.identities[0];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout>
  <!-- ============================================================================
       FLOATING STYLE STUDIO SWITCHER (底部悬浮多风格实时切换工作台)
       ============================================================================ -->
  <div
    class="fixed bottom-5 left-1/2 -translate-x-1/2 z-50 w-[95%] max-w-2xl bg-[#141413]/95 text-[#F7F6F2] backdrop-blur-md border border-[#383835] shadow-2xl p-2 sm:px-4 sm:py-2.5 rounded-2xl flex flex-col sm:flex-row items-center justify-between gap-2"
    role="region"
    aria-label="主页视觉风格实时预览切换器"
  >
    <div class="flex items-center gap-2 text-xs font-mono shrink-0">
      <span class="w-2 h-2 rounded-full bg-[#D8FF38] status-dot"></span>
      <span class="text-[#D8FF38] font-semibold">风格预览器</span>
      <span class="hidden md:inline text-[#A09E97]">（按数字键 1-4 也可切换）</span>
    </div>

    <div class="grid grid-cols-4 gap-1.5 w-full sm:w-auto" role="tablist">
      <button
        type="button"
        data-style-target="editorial"
        class="style-switch-btn px-2.5 py-1.5 rounded-lg text-xs font-mono font-medium transition-all bg-[#D8FF38] text-[#141413]"
      >
        1. 瑞士画册
      </button>
      <button
        type="button"
        data-style-target="bento"
        class="style-switch-btn px-2.5 py-1.5 rounded-lg text-xs font-mono font-medium transition-all bg-[#252523] text-[#E5E3DC] hover:bg-[#333330]"
      >
        2. 便当盒Bento
      </button>
      <button
        type="button"
        data-style-target="terminal"
        class="style-switch-btn px-2.5 py-1.5 rounded-lg text-xs font-mono font-medium transition-all bg-[#252523] text-[#E5E3DC] hover:bg-[#333330]"
      >
        3. 极客终端
      </button>
      <button
        type="button"
        data-style-target="poster"
        class="style-switch-btn px-2.5 py-1.5 rounded-lg text-xs font-mono font-medium transition-all bg-[#252523] text-[#E5E3DC] hover:bg-[#333330]"
      >
        4. 先锋海报
      </button>
    </div>
  </div>

  <!-- ============================================================================
       STYLE 1: SWISS MONOGRAPH (瑞士独立画册 / 杂志风)
       ============================================================================ -->
  <div id="style-panel-editorial" class="style-panel max-w-7xl mx-auto px-4 sm:px-8 pb-24">
    <!-- SECTION 1: EDITORIAL COVER SPREAD -->
    <section id="about" class="py-12 sm:py-20 border-b border-rule">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
        <div class="lg:col-span-7 space-y-8">
          <div class="space-y-3">
            <div class="flex flex-wrap items-center gap-3">
              <span class="inline-flex items-center gap-2 px-3 py-1 bg-surface border border-rule text-xs font-mono">
                <span class="w-2 h-2 rounded-full bg-[#D8FF38] border border-ink status-dot"></span>
                <span>{siteConfig.status}</span>
              </span>
              <span class="font-mono text-xs text-muted">
                STYLE 01 · SWISS EDITORIAL MONOGRAPH
              </span>
            </div>

            <div class="pt-2">
              <p class="font-mono text-xs text-muted tracking-wide">
                PERSONAL MONOGRAPH &amp; DIGITAL GARDEN OF
              </p>
              <h1 class="mt-1 flex flex-wrap items-baseline gap-x-4 gap-y-1">
                <span class="editorial-display text-5xl sm:text-7xl font-normal tracking-tight">
                  {siteConfig.name}
                </span>
                <span class="font-serif text-3xl sm:text-5xl font-semibold text-cobalt">
                  {siteConfig.nameCn}
                </span>
              </h1>
            </div>
          </div>

          <div class="space-y-3">
            <div class="text-xs font-mono text-muted">
              切换视角以查看不同维度的工作重心：
            </div>
            <div role="tablist" aria-label="身份视角切换" class="flex flex-wrap gap-2">
              {
                siteConfig.identities.map((lens, idx) => (
                  <button
                    type="button"
                    role="tab"
                    aria-selected={idx === 0 ? 'true' : 'false'}
                    data-lens-id={lens.id}
                    data-lens-headline={lens.headline}
                    data-lens-manifesto={lens.manifesto}
                    data-lens-highlights={JSON.stringify(lens.highlights)}
                    class="lens-tab px-3.5 py-1.5 text-xs sm:text-sm font-medium border border-rule bg-surface hover:border-ink transition-all"
                  >
                    {lens.label}
                  </button>
                ))
              }
            </div>
          </div>

          <div class="space-y-5 pt-1">
            <h2
              id="hero-headline"
              class="font-serif text-2xl sm:text-4xl leading-snug font-normal text-ink transition-opacity duration-200"
            >
              {defaultLens.headline}
            </h2>
            <p
              id="hero-manifesto"
              class="text-base sm:text-lg text-muted leading-relaxed max-w-2xl transition-opacity duration-200"
            >
              {defaultLens.manifesto}
            </p>
            <div id="hero-highlights" class="flex flex-wrap gap-2 pt-1">
              {
                defaultLens.highlights.map((tag) => (
                  <span class="font-mono text-xs px-2.5 py-1 border border-rule bg-paper text-ink">
                    {tag}
                  </span>
                ))
              }
            </div>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="border border-ink bg-surface p-6 sm:p-8 relative">
            <div class="flex items-start justify-between border-b border-rule pb-5">
              <div>
                <p class="font-mono text-xs text-muted">INDEX CARD</p>
                <p class="font-serif text-2xl mt-0.5">Creator Dossier</p>
              </div>
              <span class="font-mono text-xs px-2.5 py-1 bg-[#D8FF38] text-[#141413] font-medium border border-[#141413]">
                VERIFIED · 2026
              </span>
            </div>

            <div class="my-6 border border-rule bg-paper p-5 relative overflow-hidden">
              <svg viewBox="0 0 400 170" class="w-full h-36 sm:h-40" aria-hidden="true">
                <line x1="0" y1="35" x2="400" y2="35" stroke="currentColor" stroke-opacity="0.12" />
                <line x1="0" y1="85" x2="400" y2="85" stroke="currentColor" stroke-opacity="0.12" />
                <line x1="0" y1="135" x2="400" y2="135" stroke="currentColor" stroke-opacity="0.12" />
                <line x1="90" y1="0" x2="90" y2="170" stroke="currentColor" stroke-opacity="0.12" />
                <line x1="260" y1="0" x2="260" y2="170" stroke="currentColor" stroke-opacity="0.12" />
                <circle cx="90" cy="85" r="56" fill="none" stroke="var(--accent-cobalt)" stroke-width="2.5" />
                <circle cx="90" cy="85" r="24" fill="var(--accent-cobalt)" />
                <rect x="236" y="42" width="88" height="86" fill="#D8FF38" stroke="#141413" stroke-width="1.5" />
                <text x="250" y="92" font-family="Instrument Serif, serif" font-size="34" font-style="italic" fill="#141413">
                  Aa / 格
                </text>
                <path d="M 146 85 C 185 85, 195 60, 236 60" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 4" />
              </svg>
              <div class="flex justify-between items-center text-[11px] font-mono text-muted pt-2 border-t border-rule">
                <span>FIG 1.0 — FORM &amp; COMPUTATION</span>
                <span>SCALE 1:1</span>
              </div>
            </div>

            <dl class="space-y-3 text-sm border-b border-rule pb-5">
              <div class="flex justify-between py-1 border-b border-rule/60">
                <dt class="font-mono text-xs text-muted">主力方向</dt>
                <dd class="font-medium text-right">全栈产品工程 / 视觉设计系统</dd>
              </div>
              <div class="flex justify-between py-1 border-b border-rule/60">
                <dt class="font-mono text-xs text-muted">技术偏好</dt>
                <dd class="font-mono text-xs text-right">Astro · React · TypeScript · Rust</dd>
              </div>
              <div class="flex justify-between py-1">
                <dt class="font-mono text-xs text-muted">所在城市</dt>
                <dd class="font-medium text-right">{siteConfig.location}</dd>
              </div>
            </dl>

            <div class="pt-5 flex flex-wrap gap-3">
              <button
                type="button"
                onclick={`window.copySiteEmail('${siteConfig.email}')`}
                class="flex-1 min-w-[160px] px-4 py-2.5 bg-ink text-paper text-xs sm:text-sm font-mono font-medium hover:bg-cobalt hover:text-white transition-colors text-center"
              >
                复制邮箱 · {siteConfig.email}
              </button>
              <a
                href="#works"
                class="px-4 py-2.5 border border-ink text-xs sm:text-sm font-mono font-medium hover:bg-ink hover:text-paper transition-colors"
              >
                浏览作品集 ↓
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: SELECTED WORKS -->
    <section id="works" class="py-16 sm:py-24 border-b border-rule">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-10 border-b border-rule">
        <div>
          <p class="font-mono text-xs text-cobalt">SELECTED ARCHIVE · 2025—2026</p>
          <h2 class="editorial-display text-4xl sm:text-6xl mt-1">
            代表作品与实验项目
          </h2>
        </div>

        <div class="flex flex-wrap gap-2" role="group" aria-label="作品分类筛选">
          <button type="button" aria-pressed="true" data-filter="all" class="filter-pill px-3.5 py-1.5 text-xs font-mono border border-rule bg-surface transition-colors">
            全部作品 ({siteConfig.projects.length})
          </button>
          <button type="button" aria-pressed="false" data-filter="design" class="filter-pill px-3.5 py-1.5 text-xs font-mono border border-rule bg-surface transition-colors">
            设计系统 · Design
          </button>
          <button type="button" aria-pressed="false" data-filter="ai" class="filter-pill px-3.5 py-1.5 text-xs font-mono border border-rule bg-surface transition-colors">
            AI 与工具 · Agent
          </button>
          <button type="button" aria-pressed="false" data-filter="engineering" class="filter-pill px-3.5 py-1.5 text-xs font-mono border border-rule bg-surface transition-colors">
            创意工程 · Engineering
          </button>
        </div>
      </div>

      <div class="divide-y divide-rule">
        {
          siteConfig.projects.map((project) => (
            <article
              data-project-category={project.category}
              class="project-item py-10 sm:py-14 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center group"
            >
              <div class="lg:col-span-5">
                <a
                  href={project.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block border border-rule bg-surface p-6 group-hover:border-ink transition-colors relative overflow-hidden"
                >
                  <div class="flex items-center justify-between text-xs font-mono text-muted mb-4">
                    <span>{project.index}</span>
                    <span class="px-2 py-0.5 border border-rule bg-paper text-ink">
                      {project.categoryLabel}
                    </span>
                  </div>

                  <div class="h-44 bg-paper border border-rule flex items-center justify-center p-4 overflow-hidden">
                    {project.visualType === 'type-specimen' && (
                      <svg viewBox="0 0 360 180" class="w-full h-full">
                        <rect x="16" y="16" width="328" height="148" fill="none" stroke="currentColor" stroke-opacity="0.2" />
                        <line x1="16" y1="64" x2="344" y2="64" stroke="var(--accent-cobalt)" stroke-width="1" stroke-dasharray="3 3" />
                        <line x1="16" y1="128" x2="344" y2="128" stroke="var(--accent-cobalt)" stroke-width="1" stroke-dasharray="3 3" />
                        <text x="32" y="118" font-family="Instrument Serif, serif" font-size="78" fill="currentColor">Editorial</text>
                        <rect x="258" y="28" width="68" height="24" fill="#D8FF38" stroke="#141413" />
                        <text x="268" y="44" font-family="JetBrains Mono, monospace" font-size="11" fill="#141413">GRID 12X</text>
                      </svg>
                    )}
                    {project.visualType === 'neural-topology' && (
                      <svg viewBox="0 0 360 180" class="w-full h-full">
                        <path d="M 55 90 Q 140 25, 210 90 T 310 65" fill="none" stroke="var(--accent-cobalt)" stroke-width="2" />
                        <path d="M 55 90 Q 140 155, 210 90 T 310 125" fill="none" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.5" />
                        <circle cx="55" cy="90" r="14" fill="#D8FF38" stroke="#141413" stroke-width="2" />
                        <circle cx="155" cy="56" r="9" fill="var(--accent-cobalt)" />
                        <circle cx="210" cy="90" r="16" fill="currentColor" />
                        <circle cx="310" cy="65" r="11" fill="#D8FF38" stroke="#141413" stroke-width="2" />
                      </svg>
                    )}
                    {project.visualType === 'audio-synth' && (
                      <svg viewBox="0 0 360 180" class="w-full h-full">
                        {Array.from({ length: 18 }).map((_, i) => {
                          const h = 24 + ((i * 37) % 100);
                          const y = 90 - h / 2;
                          return (
                            <rect
                              x={28 + i * 17}
                              y={y}
                              width="9"
                              height={h}
                              fill={i % 4 === 0 ? 'var(--accent-cobalt)' : i % 7 === 0 ? '#D8FF38' : 'currentColor'}
                              opacity={i % 4 === 0 || i % 7 === 0 ? '1' : '0.22'}
                            />
                          );
                        })}
                      </svg>
                    )}
                    {project.visualType === 'kinetic-grid' && (
                      <svg viewBox="0 0 360 180" class="w-full h-full">
                        <rect x="40" y="24" width="110" height="132" fill="none" stroke="currentColor" stroke-width="1.5" />
                        <rect x="150" y="24" width="110" height="132" fill="var(--accent-cobalt)" fill-opacity="0.12" stroke="var(--accent-cobalt)" stroke-width="1.5" />
                        <rect x="210" y="44" width="105" height="92" fill="#D8FF38" stroke="#141413" stroke-width="1.5" />
                        <text x="56" y="75" font-family="Instrument Serif, serif" font-size="28" fill="currentColor">MD</text>
                        <text x="228" y="96" font-family="Instrument Serif, serif" font-size="28" fill="#141413">PDF / 印</text>
                      </svg>
                    )}
                  </div>
                </a>
              </div>

              <div class="lg:col-span-7 space-y-4">
                <div class="flex items-center gap-3 font-mono text-xs text-muted">
                  <span>{project.index}</span>
                  <span>/</span>
                  <span>{project.year}</span>
                </div>
                <h3 class="font-serif text-3xl sm:text-4xl font-normal tracking-tight">
                  {project.title}
                </h3>
                <p class="text-base sm:text-lg font-medium text-ink/90">{project.subtitle}</p>
                <p class="text-muted leading-relaxed text-sm sm:text-base max-w-2xl">{project.summary}</p>
                <div class="inline-block px-3.5 py-1.5 bg-surface border-l-2 border-cobalt text-xs sm:text-sm font-medium">
                  {project.impact}
                </div>
                <div class="pt-2 flex flex-wrap gap-2">
                  {project.tech.map((t) => (
                    <span class="font-mono text-xs px-2.5 py-1 border border-rule bg-paper">{t}</span>
                  ))}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- SECTION 3: FIELD NOTES -->
    <section id="notes" class="py-16 sm:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
        <div class="lg:col-span-4 space-y-4">
          <p class="font-mono text-xs text-cobalt">FIELD NOTES &amp; ESSAYS</p>
          <h2 class="editorial-display text-4xl sm:text-5xl">思考札记与长文专栏</h2>
          <p class="text-sm sm:text-base text-muted leading-relaxed">
            点击任意文章即可进入沉浸式双栏杂志阅读页。
          </p>
        </div>
        <div class="lg:col-span-8 divide-y divide-rule border-t border-b border-rule">
          {
            siteConfig.notes.map((note) => (
              <article class="py-7 group">
                <a href={`${base}/notes/${note.slug}`} class="block space-y-2.5">
                  <div class="flex items-center justify-between font-mono text-xs text-muted">
                    <span>{note.category} · {note.readingTime}</span>
                    <time>{note.date}</time>
                  </div>
                  <h3 class="font-serif text-2xl sm:text-3xl font-normal group-hover:text-cobalt transition-colors">
                    {note.title}
                  </h3>
                  <p class="text-sm text-muted leading-relaxed">{note.excerpt}</p>
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </div>

  <!-- ============================================================================
       STYLE 2: TACTILE BENTO STUDIO (现代便当盒卡片画廊风 — Apple / Read.cv 质感)
       ============================================================================ -->
  <div id="style-panel-bento" class="style-panel hidden bg-[#ECE9E2] text-[#181816] min-h-screen py-10 sm:py-16 pb-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-8 space-y-6">
      <!-- Top Style Badge -->
      <div class="flex items-center justify-between">
        <span class="px-3.5 py-1 rounded-full bg-white border border-black/10 text-xs font-medium shadow-sm">
          ✨ 风格二：Tactile Bento Studio（苹果便当盒 / 模块化数字名片）
        </span>
        <span class="text-xs font-mono text-[#6E6C65]">ROUNDED MODULAR MATRIX</span>
      </div>

      <!-- Primary Bento Grid (12 Columns) -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
        <!-- Bento Tile 1: Bio & Avatar Hero (7 cols) -->
        <div class="bento-card md:col-span-7 p-7 sm:p-9 flex flex-col justify-between space-y-6">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3.5">
              <div class="w-14 h-14 rounded-2xl bg-[#0F5243] text-white flex items-center justify-center font-serif text-2xl font-bold shadow-md">
                {siteConfig.nameCn.slice(0, 1)}
              </div>
              <div>
                <h1 class="text-2xl sm:text-3xl font-bold tracking-tight">
                  {siteConfig.nameCn} · {siteConfig.name}
                </h1>
                <p class="text-xs sm:text-sm text-[#686660]">
                  Independent Product Engineer &amp; Design Technologist
                </p>
              </div>
            </div>
            <span class="hidden sm:inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#E6F4EA] text-[#0F5243] text-xs font-medium">
              <span class="w-2 h-2 rounded-full bg-[#0F5243]"></span>
              Available
            </span>
          </div>

          <div class="space-y-3">
            <h2 class="text-xl sm:text-2xl font-semibold leading-snug text-[#141413]">
              {defaultLens.headline}
            </h2>
            <p class="text-sm sm:text-base text-[#5A5852] leading-relaxed">
              {defaultLens.manifesto}
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-3 pt-2">
            <button
              type="button"
              onclick={`window.copySiteEmail('${siteConfig.email}')`}
              class="px-5 py-2.5 rounded-full bg-[#141413] text-white text-xs sm:text-sm font-medium hover:bg-[#0F5243] transition-colors"
            >
              复制邮箱 · {siteConfig.email}
            </button>
            {
              siteConfig.socials.slice(0, 3).map((s) => (
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-4 py-2.5 rounded-full bg-[#F5F3EE] hover:bg-[#E5E1D8] text-xs sm:text-sm font-medium transition-colors"
                >
                  {s.label}
                </a>
              ))
            }
          </div>
        </div>

        <!-- Bento Tile 2: Location & Metrics (5 cols) -->
        <div class="md:col-span-5 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-1 gap-5">
          <!-- Map / Status Pill Card -->
          <div class="bento-card p-6 bg-gradient-to-br from-[#0F5243] to-[#09352B] text-white flex flex-col justify-between">
            <div class="flex items-center justify-between text-xs opacity-80 font-mono">
              <span>BASE COORDINATES</span>
              <span>{siteConfig.location}</span>
            </div>
            <div class="my-4">
              <p class="text-xs uppercase tracking-wider opacity-75">Current Focus</p>
              <p class="text-base sm:text-lg font-medium mt-1 leading-snug">
                {siteConfig.nowSlice.building}
              </p>
            </div>
            <div class="flex items-center justify-between text-xs pt-3 border-t border-white/15">
              <span>Reading: {siteConfig.nowSlice.reading.split('—')[0]}</span>
              <span class="px-2 py-0.5 rounded-full bg-white/20">2026</span>
            </div>
          </div>

          <!-- Numbers Strip Card -->
          <div class="bento-card p-6 grid grid-cols-3 gap-3 items-center text-center">
            {
              siteConfig.nowSlice.metrics.map((m) => (
                <div class="p-2 rounded-2xl bg-[#F7F5F0]">
                  <div class="text-xl sm:text-2xl font-bold text-[#FF5A26]">{m.value}</div>
                  <div class="text-xs text-[#686660] mt-1">{m.label}</div>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Bento Projects Section (2x2 Grid of Rounded Cards) -->
        {
          siteConfig.projects.map((project, idx) => (
            <div class="bento-card md:col-span-6 p-6 sm:p-7 flex flex-col justify-between space-y-5">
              <div class="flex items-center justify-between">
                <span
                  class={`px-3 py-1 rounded-full text-xs font-medium ${
                    idx % 2 === 0
                      ? 'bg-[#FFF0EB] text-[#FF5A26]'
                      : 'bg-[#E6F4EA] text-[#0F5243]'
                  }`}
                >
                  {project.categoryLabel} · {project.year}
                </span>
                <a
                  href={project.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-9 h-9 rounded-full bg-[#F4F2ED] hover:bg-[#141413] hover:text-white flex items-center justify-center transition-colors text-sm"
                >
                  ↗
                </a>
              </div>

              <div class="space-y-2">
                <h3 class="text-xl sm:text-2xl font-bold tracking-tight">{project.title}</h3>
                <p class="text-sm font-medium text-[#3A3935]">{project.subtitle}</p>
                <p class="text-xs sm:text-sm text-[#6E6C65] leading-relaxed">{project.summary}</p>
              </div>

              <div class="pt-2 flex flex-wrap gap-1.5">
                {project.tech.map((t) => (
