  <!-- Client Interactivity for Style Switcher, Identity Lens & Portfolio Filter -->
  <script is:inline>
    // 0. Live Style Switcher (1: editorial, 2: bento, 3: terminal, 4: poster)
    const styleBtns = document.querySelectorAll('.style-switch-btn');
    const stylePanels = {
      editorial: document.getElementById('style-panel-editorial'),
      bento: document.getElementById('style-panel-bento'),
      terminal: document.getElementById('style-panel-terminal'),
      poster: document.getElementById('style-panel-poster'),
    };

    function activateStyle(styleKey) {
      if (!stylePanels[styleKey]) return;
      Object.entries(stylePanels).forEach(([key, panel]) => {
        if (!panel) return;
        if (key === styleKey) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });

      styleBtns.forEach((btn) => {
        const target = btn.getAttribute('data-style-target');
        if (target === styleKey) {
          btn.className =
            'style-switch-btn px-2.5 py-1.5 rounded-lg text-xs font-mono font-medium transition-all bg-[#D8FF38] text-[#141413]';
        } else {
          btn.className =
            'style-switch-btn px-2.5 py-1.5 rounded-lg text-xs font-mono font-medium transition-all bg-[#252523] text-[#E5E3DC] hover:bg-[#333330]';
        }
      });

      localStorage.setItem('preferred-site-style', styleKey);
    }

    styleBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-style-target');
        if (target) activateStyle(target);
      });
    });

    // Keyboard shortcuts 1, 2, 3, 4
    window.addEventListener('keydown', (e) => {
      if (['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName || '')) return;
      if (e.key === '1') activateStyle('editorial');
      if (e.key === '2') activateStyle('bento');
      if (e.key === '3') activateStyle('terminal');
      if (e.key === '4') activateStyle('poster');
    });

    // Restore saved style or URL ?style= parameter
    const urlStyle = new URLSearchParams(window.location.search).get('style');
    const savedStyle = localStorage.getItem('preferred-site-style');
    if (urlStyle && stylePanels[urlStyle]) {
      activateStyle(urlStyle);
    } else if (savedStyle && stylePanels[savedStyle]) {
      activateStyle(savedStyle);
    }

    // 1. Hero Identity Lens Switcher
    const lensTabs = document.querySelectorAll('.lens-tab');
    const headlineEl = document.getElementById('hero-headline');
    const manifestoEl = document.getElementById('hero-manifesto');
    const highlightsEl = document.getElementById('hero-highlights');

    lensTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        lensTabs.forEach((t) => t.setAttribute('aria-selected', 'false'));
        tab.setAttribute('aria-selected', 'true');

        const headline = tab.getAttribute('data-lens-headline');
        const manifesto = tab.getAttribute('data-lens-manifesto');
        const highlights = JSON.parse(tab.getAttribute('data-lens-highlights') || '[]');

        if (headlineEl && manifestoEl && highlightsEl) {
          headlineEl.style.opacity = '0.2';
          manifestoEl.style.opacity = '0.2';

          setTimeout(() => {
            headlineEl.textContent = headline;
            manifestoEl.textContent = manifesto;
            highlightsEl.innerHTML = highlights
              .map(
                (tag) =>
                  `<span class="font-mono text-xs px-2.5 py-1 border border-rule bg-paper text-ink">${tag}</span>`
              )
              .join('');
            headlineEl.style.opacity = '1';
            manifestoEl.style.opacity = '1';
          }, 120);
        }
      });
    });

    // 2. Portfolio Category Filter
    const filterBtns = document.querySelectorAll('.filter-pill');
    const projectItems = document.querySelectorAll('.project-item');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => b.setAttribute('aria-pressed', 'false'));
        btn.setAttribute('aria-pressed', 'true');

        const filter = btn.getAttribute('data-filter');
        projectItems.forEach((item) => {
          const cat = item.getAttribute('data-project-category');
          if (filter === 'all' || cat === filter) {
            item.style.display = '';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });
  </script>
