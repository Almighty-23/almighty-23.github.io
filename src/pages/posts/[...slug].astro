---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../data/siteConfig';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await post.render();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title={`${post.data.title} — ${siteConfig.name}`} description={post.data.summary || post.data.title}>
  <div class="aura-bg min-h-screen py-10 sm:py-16 px-4 sm:px-8">
    <div class="max-w-3xl mx-auto space-y-6">
      <!-- Top Frosted Back Bar -->
      <div class="glass-card px-6 py-3.5 flex items-center justify-between text-xs">
        <a
          href={`${base}/#notes`}
          class="font-medium text-slate-700 hover:text-slate-950 flex items-center gap-2 transition-colors"
        >
          <span>← 返回首页目录</span>
        </a>
        <span class="px-3 py-1 rounded-full bg-white/70 font-mono text-slate-600">
          {post.data.category}
        </span>
      </div>

      <!-- Main Frosted Article Card -->
      <article class="glass-card p-7 sm:p-12 space-y-8">
        <header class="border-b border-slate-200/70 pb-7 space-y-3">
          <div class="flex items-center gap-3 text-xs font-mono text-slate-500">
            <time>{post.data.date}</time>
            <span>·</span>
            <span>{siteConfig.name}</span>
          </div>
          <h1 class="text-2xl sm:text-4xl font-bold text-slate-900 leading-snug">
            {post.data.title}
          </h1>
          {post.data.summary && (
            <p class="text-sm sm:text-base text-slate-500 leading-relaxed pt-1">
              {post.data.summary}
            </p>
          )}
        </header>

        <div class="article-prose">
          <Content />
        </div>
      </article>
    </div>
  </div>
</BaseLayout>
