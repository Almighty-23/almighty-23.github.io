---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig, type NoteItem } from '../../data/siteConfig';

export function getStaticPaths() {
  if (!siteConfig.notes || siteConfig.notes.length === 0) {
    return [];
  }
  return siteConfig.notes.map((note, idx) => ({
    params: { slug: note.slug },
    props: {
      note,
      nextNote: siteConfig.notes.length > 1 ? siteConfig.notes[(idx + 1) % siteConfig.notes.length] : null,
    },
  }));
}

interface Props {
  note: NoteItem;
  nextNote: NoteItem | null;
}

const { note, nextNote } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title={`${note.title} — ${siteConfig.name}`} description={note.excerpt}>
  <article class="max-w-4xl mx-auto px-4 sm:px-8 py-12 sm:py-20">
    <div class="pb-6 border-b border-black/10 flex items-center justify-between text-xs font-mono">
      <a href={`${base}/#notes`} class="hover:underline flex items-center gap-2">
        <span>← 返回首页目录</span>
      </a>
      <span class="opacity-60">{note.category}</span>
    </div>

    <header class="py-10 space-y-4">
      <time class="font-mono text-xs opacity-60">{note.date}</time>
      <h1 class="text-3xl sm:text-5xl font-bold leading-tight">{note.title}</h1>
      {note.subtitle && <p class="text-lg opacity-75">{note.subtitle}</p>}
    </header>

    <div class="prose max-w-none space-y-5 leading-relaxed">
      {note.content.map((p) => <p>{p}</p>)}
    </div>

    {nextNote && (
      <footer class="mt-14 pt-8 border-t border-black/10">
        <a href={`${base}/notes/${nextNote.slug}`} class="text-sm font-mono hover:underline">
          下一篇：{nextNote.title} →
        </a>
      </footer>
    )}
  </article>
</BaseLayout>
